rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS DE SÉCURITÉ ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ── RÈGLE PAR DÉFAUT : REFUS TOTAL ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── PROFILS PUBLICS (Pour le classement - données anonymisées et minimales) ──
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'is_vip',
        'lame_points',
        'total_lame_earned',
        'role'
      ]);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── PROFIL UTILISATEUR (Données privées: email, domicile, travail, Lames) ──
    match /users/{userId} {
      // Lecture : STRICTEMENT restreinte au propriétaire (protection RGPD du domicile et de l'e-mail)
      allow read: if isOwner(userId) || isAdmin();
      
      // Création : Seulement par le propriétaire à l'inscription (avec validation anti-usurpation)
      allow create: if isOwner(userId)
        && (!('lame_points' in request.resource.data) || request.resource.data.lame_points == 0)
        && (!('total_lame_earned' in request.resource.data) || request.resource.data.total_lame_earned == 0)
        && (!('is_vip' in request.resource.data) || request.resource.data.is_vip == false)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      // Mise à jour : STRICTEMENT par le propriétaire (les relations d'amis sont gérées par Cloud Functions sécurisées)
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'lame_points',
        'total_lame_earned',
        'is_vip',
        'role',
        'current_level',
        'next_level_boost',
        'unlocked_badges',
        'consecutive_logins',
        'ad_points',
        'store_boosts',
        'stripe_customer_id',
        'stripe_subscription_id',
        'stripe_subscription_item_id'
      ]);

      // Suppression du compte (RGPD Art. 17) par le propriétaire ou l'admin
      allow delete: if isOwner(userId) || isAdmin();

      // ── SOUS-COLLECTIONS UTILISATEUR ──────────────────────────────────────

      // Historique des gains de Lames (Géré exclusivement par Cloud Functions sécurisées)
      match /lame_history/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Logs de trajet (Création/mise à jour par le client, suppression strictement interdite pour anti-triche)
      match /trip_logs/{tripId} {
        allow read, create: if isOwner(userId);
        allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'validation_status',
          'validated_at'
        ]);
        allow delete: if false; // Empêche la suppression des trajets flagués comme triche
      }

      // Historique de cashback magasin (Écriture serveur uniquement via claimCashback)
      match /cashback_history/{cbId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ── STATISTIQUES UTILISATEUR (Collection Racine) ─────────────────────────
    match /user_stats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Permet au client de rafraîchir les timestamps de défis locaux, mais interdit de modifier les totaux/points
      allow create, update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ad_points',
        'store_boosts',
        'total_lame_earned',
        'total_trips',
        'total_distance_meters',
        'total_duration_seconds',
        'total_calories',
        'daily_ad_views',
        'daily_store_boosts'
      ]);
      allow delete: if false;
    }

    // ── DÉFIS GLOBAUX & PROGRESSION UTILISATEUR ──────────────────────────────
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /user_challenges/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        docId.matches('^' + request.auth.uid + '_.*') ||
        isAdmin()
      );
      // Le client peut initier ou progresser, mais seul le serveur (validateTrip) peut valider la récompense
      allow create, update: if isAuthenticated() 
        && request.resource.data.user_id == request.auth.uid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reward_already_credited'])
            || request.resource.data.reward_already_credited == false)
        && (!('status' in request.resource.data) || request.resource.data.status != 'rewardClaimed' || (resource != null && resource.data.status == 'rewardClaimed'));
      allow delete: if isAdmin();
    }

    // ── COMMERCES & TRANSACTIONS ─────────────────────────────────────────────
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /store_transactions/{transId} {
        allow read: if isAuthenticated();
        allow write: if false; // Écriture exclusivement gérée par claimCashback
      }
    }

    // ── BOUTIQUE & RÉCOMPENSES ───────────────────────────────────────────────
    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_claimed_offers/{docId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── CONCOURS & ENCHÈRES (Gestion autoritaire Cloud Functions) ────────────
    match /contests/{contestId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /contest_state/{contestId} {
      allow read: if isAuthenticated();
      allow write: if false; // Géré par placeBid / purchaseRaffleTicket
    }

    match /contest_entries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if false; // Seul le serveur valide les entrées et déduit les Lames
    }

    // ── DONATIONS & CAMPAGNES ────────────────────────────────────────────────
    match /campaign_donations/{donationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Géré par processDonation
    }

    // ── VALIDATION OCR & JETONS ANTI-REJEU ───────────────────────────────────
    match /ocr_validations/{tokenId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow write: if false; // Géré par processReceiptOCR
    }

    match /cashback_claims/{claimHash} {
      allow read, write: if false; // Hash SHA-256 privé exclusivement géré par le backend
    }

    // ── CLASSEMENT & LOGS ────────────────────────────────────────────────────
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false; // Généré par la fonction planifiée updateDailyLeaderboard
    }

    match /user_activity_logs/{docId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ── GESTION DE L'UNICITÉ DES PSEUDOS (Item 67) ───────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── EMAILS TRANSACTIONNELS (Item 59 : Accès serveur exclusif) ────────────
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}

