rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règle globale pour la collection des utilisateurs (RGPD : lecture stricte réservée au seul propriétaire)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // L'utilisateur peut mettre à jour son profil (ex: domicile), mais NE PEUT PAS modifier ses champs sensibles
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'lame_points', 
                         'total_lame_earned', 
                         'is_vip', 
                         'consecutive_logins',
                         'ad_points'
                       ]);
                       
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Sous-collection historique des lames : Seul le serveur Admin SDK peut écrire, lecture réservée au propriétaire
    match /users/{userId}/lame_history/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Agrégat du classement public (Généré par Cloud Function, aucune donnée sensible)
    match /leaderboards/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Autres collections publiques / d'actions
    match /user_challenges/{docId} {
      allow read, write: if request.auth != null;
    }

    match /user_claimed_offers/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /stores/{storeId} {
      allow read: if true;
    }

    match /shop_items/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
