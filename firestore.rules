rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règle globale pour la collection des utilisateurs (RGPD : lecture stricte réservée au seul propriétaire)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // L'utilisateur peut mettre à jour son profil (ex: domicile), mais NE PEUT PAS modifier ses champs sensibles
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'lame_points', 
                         'total_lame_earned', 
                         'is_vip', 
                         'consecutive_logins',
                         'ad_points',
                         'store_boosts'
                       ]);
                       
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Sous-collections sous /users/{userId}
    match /users/{userId}/lame_history/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/trip_logs/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/cashback_history/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Statistiques des utilisateurs (ex: cycle de rafraîchissement des défis)
    match /user_stats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Journaux d'activité utilisateur (top-level)
    match /user_activity_logs/{docId} {
      allow read, create: if request.auth != null;
    }

    // Agrégat du classement public (Généré par Cloud Function, aucune donnée sensible)
    match /leaderboards/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Défis généraux et défis utilisateur
    match /challenges/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /user_challenges/{docId} {
      allow read, write: if request.auth != null;
    }

    match /user_claimed_offers/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /stores/{storeId} {
      allow read: if true;
    }

    match /shop_items/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Concours
    match /contests/{contestId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /contest_entries/{entryId} {
      allow read, write: if request.auth != null;
    }

    // Dons aux campagnes
    match /campaign_donations/{donationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
