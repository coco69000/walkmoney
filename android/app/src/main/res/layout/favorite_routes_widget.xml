<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- En-tête -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚶 WalkMoney - Trajets favoris"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#44FFFFFF"
        android:layout_marginBottom="4dp" />

    <!-- Route 1 (toujours visible) -->
    <LinearLayout
        android:id="@+id/route_row_1"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="@drawable/route_item_background"
        android:layout_marginBottom="3dp">
        <ImageView
            android:id="@+id/route_icon_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_directions_walk"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/route_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aucun trajet favori"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/route_dest_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajoutez des favoris dans l'app"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Route 2 -->
    <LinearLayout
        android:id="@+id/route_row_2"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="@drawable/route_item_background"
        android:layout_marginBottom="3dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/route_icon_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_directions_walk"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/route_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/route_dest_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Route 3 -->
    <LinearLayout
        android:id="@+id/route_row_3"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="@drawable/route_item_background"
        android:visibility="gone">
        <ImageView
            android:id="@+id/route_icon_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_directions_walk"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/route_name_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/route_dest_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
