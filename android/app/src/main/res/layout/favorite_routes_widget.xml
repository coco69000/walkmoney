<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚶 WalkMoney - Trajets favoris"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingBottom="6dp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#44FFFFFF"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/route_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/route_item_background"
        android:layout_marginBottom="4dp"
        android:padding="6dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/route_icon_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_directions_walk"
                android:layout_marginEnd="6dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/route_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aucun trajet favori"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <TextView
                    android:id="@+id/route_dest_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ajoutez des favoris dans l'app"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <LinearLayout
                android:id="@+id/transport_walk_1"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#33FFFFFF"
                android:layout_marginEnd="2dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_directions_walk" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Marche"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/transport_bike_1"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#33FFFFFF"
                android:layout_marginEnd="2dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_directions_bike" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Vélo"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/transport_transit_1"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#33FFFFFF">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_directions_bus" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Bus"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/route_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/route_item_background"
        android:layout_marginBottom="4dp"
        android:padding="6dp"
        android:visibility="gone">
        <LinearLayout
