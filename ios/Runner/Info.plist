<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Walkmoney</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>walkmoney</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- 1. GÉOLOCALISATION (Arrière-plan + Premier plan) -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>EcoNav a besoin de votre position pour calculer vos trajets écologiques et attribuer vos Lames.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>EcoNav a besoin du suivi continu de votre position en arrière-plan pour valider vos déplacements et vos défis.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>EcoNav a besoin de votre position même fermée pour suivre vos trajets.</string>

		<!-- 2. CAPTEURS DE MOUVEMENT / FITNESS (Accéléromètre & Anti-triche) -->
		<key>NSMotionUsageDescription</key>
		<string>EcoNav utilise les capteurs de mouvement pour détecter précisément vos accélérations et freinages.</string>

		<!-- 3. APPAREIL PHOTO & GALERIE (Scan de tickets de caisse & OCR) -->
		<key>NSCameraUsageDescription</key>
		<string>EcoNav a besoin de la caméra pour scanner vos tickets de caisse et valider votre cashback.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>EcoNav a besoin d'accéder à vos photos pour soumettre des preuves d'achats.</string>

		<!-- 4. MODES ARRIÈRE-PLAN ACTIVÉS -->
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>fetch</string>
			<string>processing</string>
		</array>

		<!-- 5. LIENS EXTERNES (url_launcher / Stripe) -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>https</string>
			<string>http</string>
		</array>
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>dev.flutter.background.refresh</string>
		</array>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
